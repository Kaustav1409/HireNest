{
  "buildCommand": "echo 'Static site — no build needed'",
  "outputDirectory": "src/main/resources/static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hirenest-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hirenest-backend.onrender.com/uploads/:path*"
    }
  ]
}
