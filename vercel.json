{
  "buildCommand": "node scripts/generate-vercel-json.js",
  "outputDirectory": "src/main/resources/static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-RENDER-URL.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REPLACE-WITH-RENDER-URL.onrender.com/uploads/:path*"
    }
  ]
}
